pragma language_version 0.15;

import CompactStandardLibrary;

// Public state - vote tallies (visible on blockchain)
export ledger yesVotes: Counter;
export ledger noVotes: Counter;

// Initialize voting with zero votes
export circuit initVoting(): [] {
  yesVotes.reset();
  noVotes.reset();
}

// Cast a private vote - choice is Witness (stays on your device)
export circuit castVote(choice: Witness<Bool>): [] {
  if (choice.value) {
    yesVotes.increment(1);
  } else {
    noVotes.increment(1);
  }
}